# The admin bundle runs on React 16 (Draftail/Draft.js constraint); the Puck
# editor bundle is built in isolation against an aliased React 18 (react18 /
# react-dom18) via client/webpack.puck.config.js. Puck's `react@^18||^19` peer
# is satisfied through that webpack alias, not the root `react@16`, so npm's
# literal peer check is a false conflict here — allow it.
legacy-peer-deps=true

# Local/CI environments run Node 22; the repo declares engines.node >=24.
engine-strict=false
