{
  "name": "wagtail",
  "version": "1.0.0",
  "repository": "https://github.com/wagtail/wagtail",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "browserslist": [
    "Firefox ESR",
    "last 2 Chrome versions",
    "last 2 ChromeAndroid versions",
    "last 2 Edge versions",
    "last 1 Firefox version",
    "iOS >= 17",
    "Safari >= 16"
  ],
  "jest": {
    "coveragePathIgnorePatterns": [
      "/node_modules/",
      "/tests/"
    ],
    "projects": [
      {
        "displayName": "default",
        "moduleFileExtensions": [
          "js",
          "ts",
          "tsx",
          "json",
          "node"
        ],
        "moduleNameMapper": {
          "jquery": "<rootDir>/wagtail/admin/static_src/wagtailadmin/js/vendor/jquery-3.6.0.min.js"
        },
        "transform": {
          "^.+\\.(js|ts|tsx)$": "ts-jest"
        },
        "testEnvironment": "jsdom",
        "testPathIgnorePatterns": [
          "/node_modules/",
          "/build/",
          "client/tests/integration",
          "client/src/components/Puck/",
          "client/src/entrypoints/admin/puck.test",
          "client/src/entrypoints/ssr/"
        ],
        "setupFiles": [
          "./client/tests/adapter.js",
          "./client/tests/stubs.js",
          "./client/tests/mock-fetch.js",
          "./client/tests/mock-jquery.js"
        ],
        "setupFilesAfterEnv": [
          "./client/tests/utils.js"
        ],
        "snapshotSerializers": [
          "enzyme-to-json/serializer"
        ]
      },
      {
        "displayName": "puck",
        "testEnvironment": "jsdom",
        "moduleFileExtensions": [
          "tsx",
          "ts",
          "jsx",
          "js",
          "json",
          "node"
        ],
        "testMatch": [
          "<rootDir>/client/src/components/Puck/**/*.test.{ts,tsx}",
          "<rootDir>/client/src/entrypoints/admin/puck.test.{ts,tsx}",
          "<rootDir>/client/src/entrypoints/ssr/**/*.test.{ts,tsx}"
        ],
        "moduleNameMapper": {
          "^react$": "react18",
          "^react-dom$": "react-dom18",
          "^react-dom/(.*)$": "react-dom18/$1",
          "^react/(.*)$": "react18/$1",
          "\\.(css|scss)$": "<rootDir>/client/tests/style-mock.js"
        },
        "transform": {
          "^.+\\.(js|jsx|ts|tsx)$": [
            "babel-jest",
            {
              "babelrc": false,
              "configFile": false,
              "presets": [
                [
                  "@babel/preset-env",
                  {
                    "targets": {
                      "node": "current"
                    }
                  }
                ],
                [
                  "@babel/preset-react",
                  {
                    "runtime": "automatic"
                  }
                ],
                "@babel/preset-typescript"
              ]
            }
          ]
        },
        "setupFilesAfterEnv": [
          "./client/tests/puck-setup.js"
        ]
      }
    ]
  },
  "devDependencies": {
    "@babel/core": "^7.28.4",
    "@babel/preset-env": "^7.28.3",
    "@babel/preset-react": "^7.27.1",
    "@babel/preset-typescript": "^7.27.1",
    "@eslint/js": "^9.39.2",
    "@storybook/addon-docs": "10.2.4",
    "@storybook/addon-webpack5-compiler-babel": "^4.0.0",
    "@storybook/react-webpack5": "10.2.4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/autosize": "^4.0.3",
    "@types/draft-js": "^0.10.45",
    "@types/jest": "^29.5.14",
    "@types/jquery": "^3.5.33",
    "@types/mousetrap": "^1.6.15",
    "@types/react": "^16.14.21",
    "@types/react-dom": "^16.0",
    "@types/react-redux": "^7.1.34",
    "@types/sortablejs": "^1.15.9",
    "@typescript-eslint/eslint-plugin": "^8.20.0",
    "@typescript-eslint/parser": "^8.20.0",
    "@wagtail/eslint-config-wagtail": "^0.6.0-rc1.0",
    "@wagtail/stylelint-config-wagtail": "^0.8.0",
    "autoprefixer": "^10.4.21",
    "babel-loader": "^9.2.1",
    "concurrently": "^9.2.0",
    "copy-webpack-plugin": "^14.0.0",
    "css-loader": "^6.11.0",
    "cssnano": "^5.1.15",
    "enzyme": "^3.11.0",
    "enzyme-adapter-react-16": "^1.15.8",
    "enzyme-to-json": "^3.6.2",
    "eslint": "^9.39.2",
    "eslint-plugin-no-jquery": "^3.1.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-storybook": "^10.2.4",
    "expose-loader": "^5.0.1",
    "gettext-extractor": "^4.0.1",
    "globals": "^17.3.0",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^29.7.0",
    "mini-css-extract-plugin": "^2.9.4",
    "postcss": "^8.5.6",
    "postcss-loader": "^8.2.0",
    "prettier": "^3.8.1",
    "react-test-renderer": "^16.14.0",
    "redux-mock-store": "^1.5.5",
    "sass": "^1.97.3",
    "sass-loader": "^16.0.7",
    "storybook": "10.2.13",
    "storybook-django": "^1.1.0",
    "stylelint": "^15.11.0",
    "tailwindcss": "^3.4.14",
    "tailwindcss-vanilla-rtl": "^0.4.0",
    "ts-jest": "^29.4.5",
    "ts-loader": "^9.5.4",
    "typedoc": "^0.28.7",
    "typedoc-plugin-mdn-links": "^5.0.10",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.20.0",
    "webpack": "^5.102.1",
    "webpack-cli": "^5.1.4",
    "yaml": "^2.8.1"
  },
  "dependencies": {
    "@hotwired/stimulus": "^3.2.2",
    "@puckeditor/core": "^0.22.1",
    "@tippyjs/react": "^4.2.6",
    "a11y-dialog": "^8.1.4",
    "autosize": "^6.0.1",
    "axe-core": "^4.11.0",
    "downshift": "^9.0.10",
    "draft-js": "^0.10.5",
    "draftail": "^2.0.1",
    "draftjs-filters": "^3.0.1",
    "focus-trap-react": "^10.3.1",
    "immer": "^10.1.3",
    "js-cookie": "^3.0.5",
    "lucide-react": "^0.468.0",
    "mousetrap": "^1.6.5",
    "prop-types": "^15.8.1",
    "react": "^16.14.0",
    "react-dom": "^16.14.0",
    "react-dom18": "npm:react-dom@^18.3.1",
    "react-redux": "^8.1.3",
    "react-transition-group": "^1.1.3",
    "react18": "npm:react@^18.3.1",
    "redux": "^5.0.1",
    "redux-thunk": "^3.1.0",
    "reselect": "^5.1.1",
    "sortablejs": "^1.15.6",
    "telepath-unpack": "^0.0.4",
    "tippy.js": "^6.3.7",
    "uuid": "^11.1.0"
  },
  "scripts": {
    "postinstall": "node ./scripts/patch-puck.mjs",
    "start": "webpack --config ./client/webpack.config.js --mode development --progress --watch",
    "start:puck": "webpack --config ./client/webpack.puck.config.js --mode development --watch",
    "build": "webpack --config ./client/webpack.config.js --mode production && npm run build:puck",
    "build:puck": "webpack --config ./client/webpack.puck.config.js --mode production",
    "fix": "npm run @all -- 'npm:fix:*'",
    "fix:css": "stylelint --fix **/*.scss",
    "fix:js": "eslint --fix .",
    "format": "prettier --write \"**/?(.)*.{css,scss,js,ts,tsx,json,yaml,yml}\"",
    "lint": "npm run @all -- 'npm:lint:*'",
    "lint:js": "eslint --report-unused-disable-directives .",
    "lint:css": "stylelint **/*.scss",
    "debug:eslint": "eslint --print-config ./client/src/entrypoints/contrib/table_block/table.js",
    "lint:format": "prettier --check \"**/?(.)*.{css,scss,js,ts,tsx,json,yaml,yml}\"",
    "lint:project": "node ./scripts/check-dependencies.mjs",
    "lint:ts": "tsc --noEmit",
    "test": "npm run test:unit",
    "test:unit": "jest",
    "test:unit:watch": "jest --watch",
    "test:unit:coverage": "jest --coverage",
    "test:integration": "./client/tests/integration/node_modules/.bin/jest --config ./client/tests/integration/jest.config.js",
    "storybook": "storybook dev -c client/storybook -p 6006 --no-open --no-version-updates",
    "build-docs": "typedoc",
    "build-storybook": "storybook build -c client/storybook",
    "@all": "concurrently --group --passthrough-arguments --prefix-colors auto --timings"
  }
}
